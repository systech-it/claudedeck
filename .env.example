# ClaudeDeck configuration
# Copy this file to .env and fill in your values

# ─── Server ───────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ─── Security ─────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_32_char_string

# ─── Data storage ─────────────────────────────────────────
# Path to persistent data directory (SQLite DB + user profiles)
DATA_DIR=/app/data

# ─── Claude Code ──────────────────────────────────────────
# Path to the claude CLI binary (must be accessible by the ClaudeDeck process)
CLAUDE_BIN=/usr/local/bin/claude

# If your Claude Code installation uses an API key (not subscription),
# set it here once for all users. Leave unset if using Claude Pro/Max subscription
# (credentials are stored in Claude Code's own config directory).
# ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── Update system ────────────────────────────────────────
GITHUB_OWNER=systech-it
GITHUB_REPO=claudedeck
# Optional: GitHub token for higher API rate limits (60 req/h vs 5000 req/h)
# GITHUB_TOKEN=

# ─── Optional features ────────────────────────────────────
# Set to "true" to skip login (single-user local mode)
# SINGLE_USER_MODE=false

# Comma-separated list of allowed CORS origins (leave empty to allow same-origin only)
# CORS_ORIGINS=http://localhost:5173
