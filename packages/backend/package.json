    "fastify": "^4.28.1",
    "nanoid": "^5.0.7",
    "node-pty": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "semver": "^7.6.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.10",
